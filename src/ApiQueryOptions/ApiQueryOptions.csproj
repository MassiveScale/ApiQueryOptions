<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ApiQueryOptions</PackageId>
    <Version>1.1.0</Version>
    <Description>Lightweight OData-style query parameter parsing (filter, expand, orderby, top, skip, skiptoken) for ASP.NET Core REST APIs with IQueryable&lt;T&gt; extension methods and model binding.</Description>
    <PackageTags>aspnetcore;odata;queryoptions;filter;rest;api</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="ant_icon_128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiQueryOptions.Tests" />
  </ItemGroup>

</Project>
